# KatipAI configuration — copy to `.env` and adjust.
# All settings are optional; sensible defaults live in core/config.py.
# Every key is prefixed with KATIPAI_ and can also be set as an environment variable.

# --- Server (local only; do not expose to the network) ---
# KATIPAI_HOST=127.0.0.1
# KATIPAI_PORT=8742

# --- Storage ---
# Base directory for the SQLite DB, audio chunks and downloaded models.
# KATIPAI_DATA_DIR=~/.katipai
# Absolute path to your Obsidian vault. Leave empty to disable vault export.
# KATIPAI_VAULT_PATH=

# --- Audio / VAD ---
# KATIPAI_SAMPLE_RATE=16000
# KATIPAI_SILENCE_CHUNK_MS=2000
# KATIPAI_MIC_SILENCE_CHUNK_MS=800
# KATIPAI_MAX_CHUNK_MS=12000
# KATIPAI_SYSTEM_MAX_CHUNK_MS=25000
# KATIPAI_SILENCE_SESSION_MS=60000
# KATIPAI_VAD_THRESHOLD=0.6
# KATIPAI_MIN_AUDIO_RMS=0.012

# --- Capture toggles ---
# KATIPAI_MIC_ENABLED=true
# KATIPAI_SYSTEM_ENABLED=true
# KATIPAI_CAPTURE_ALL_SYSTEM_AUDIO=false

# --- Retention ---
# Delete recorded audio files older than this many days (0 disables purging).
# KATIPAI_AUDIO_RETENTION_DAYS=7

# --- Echo suppression (mic vs system) ---
# KATIPAI_ECHO_SUPPRESSION_ENABLED=true
# KATIPAI_ECHO_CORRELATION_THRESHOLD=0.65

# --- Voice filter (personal voice profile) ---
# KATIPAI_VOICE_FILTER_MODE=off        # off | prefer | strict
# KATIPAI_VOICE_MATCH_THRESHOLD=0.75

# --- Models (downloaded from Hugging Face on first use, ~4.5 GB total) ---
# KATIPAI_STT_MODEL=mlx-community/whisper-large-v3-turbo
# KATIPAI_STT_FALLBACK_MODEL=mlx-community/whisper-medium-mlx
# KATIPAI_STT_LANGUAGE=tr
# KATIPAI_LLM_MODEL=mlx-community/Qwen3.5-4B-OptiQ-4bit
# KATIPAI_LLM_FALLBACK_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
